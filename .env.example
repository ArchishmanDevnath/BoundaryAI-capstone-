# Copy to backend/.env to change a setting. All of these are optional and show their defaults
# unless noted. Never commit a real API key.

# Storage. The default location is backend/var.
# BG_DB_PATH=var/boundaryguard.sqlite3
# BG_RUNS_DIR=var/runs

# API hardening
BG_FRONTEND_ORIGIN=http://localhost:3000
BG_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Local LLM through Ollama (optional)
BG_OLLAMA_URL=http://127.0.0.1:11434
BG_OLLAMA_MODEL=qwen2.5:7b

# Hosted OpenAI-compatible LLM (optional, and off unless all of these are set)
BG_OPENAI_BASE_URL=
BG_OPENAI_API_KEY=
BG_OPENAI_MODEL=

# ML risk model used by configurations D and E. The model folder holds versioned bundles and a CURRENT pointer.
# BG_MODEL_DIR=models
# A prediction slower than this is treated as a failure, and the action is blocked.
BG_ML_TIMEOUT=2

# Timeouts, in seconds
BG_AGENT_TIMEOUT=300
BG_ASSESSOR_TIMEOUT=60
BG_APPROVAL_TIMEOUT=300

# Frontend (set in the frontend's environment, not in backend/.env)
# BG_API_URL=http://127.0.0.1:8000
